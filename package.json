{
  "name": "rack-inventory-studio-workspace",
  "private": true,
  "version": "0.1.0-beta.2",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@wdio/native-utils": "2.5.0",
      "serialize-javascript": ">=7.0.5",
      "ws": ">=8.21.0",
      "brace-expansion": ">=5.0.8",
      "minimatch": ">=10.2.5"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @rack-inventory-studio/desktop dev",
    "build": "pnpm --filter @rack-inventory-studio/desktop build",
    "tauri": "pnpm --filter @rack-inventory-studio/desktop tauri",
    "check:version": "node scripts/check-version-consistency.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "smoke:beta": "node scripts/smoke-beta-gate.mjs",
    "build:e2e:wdio-plugin": "node scripts/build-wdio-plugin-binary.mjs",
    "test:e2e:wdio": "node scripts/run-wdio-e2e.mjs",
    "build:e2e:wdio-embedded": "node scripts/build-wdio-embedded-binary.mjs",
    "test:e2e:wdio:embedded": "node scripts/run-wdio-e2e-embedded.mjs"
  }
}
