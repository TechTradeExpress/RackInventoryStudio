{
  "name": "rack-inventory-studio-workspace",
  "private": true,
  "version": "0.1.0-beta.2",
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@wdio/native-utils": "2.5.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @rack-inventory-studio/desktop dev",
    "build": "pnpm --filter @rack-inventory-studio/desktop build",
    "tauri": "pnpm --filter @rack-inventory-studio/desktop tauri",
    "check:version": "node scripts/check-version-consistency.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "smoke:beta": "node scripts/smoke-beta-gate.mjs"
  }
}
